{
  "name": "@campsite/styled-text-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "PORT=${PORT:-3002} AUTHTOKEN=${AUTHTOKEN:-d8c0a2827589659ff292a8999b024f24a185ed82} tsup --watch --onSuccess \"node dist/index.mjs\"",
    "lint": "eslint . --ext .ts,.tsx",
    "sentry:sourcemaps": "sentry-cli --url https://glitchtip.allbrainy.com sourcemaps inject --org camp-site --project campsite-styled-text-server ./dist && sentry-cli --url https://glitchtip.allbrainy.com sourcemaps upload --org camp-site --project campsite-styled-text-server --log-level=debug ./dist",
    "start": "node dist/index.mjs",
    "test": "vitest"
  },
  "dependencies": {
    "@campsite/editor": "workspace:*",
    "@sentry/node": "catalog:",
    "@tiptap/pm": "catalog:",
    "body-parser": "^2.3.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "jsx-slack": "^6.1.2",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@campsite/eslint-config": "workspace:*",
    "@campsite/tsconfig": "workspace:*",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.6.2",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "catalog:"
  }
}
