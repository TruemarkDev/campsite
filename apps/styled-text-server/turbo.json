{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["build"],
      "passThroughEnv": ["AUTHTOKEN", "PORT"]
    },
    "build": {
      "env": ["SENTRY_AUTH_TOKEN", "SENTRY_ORG", "SENTRY_PROJECT", "SENTRY_DSN", "NODE_ENV", "AUTHTOKEN", "PORT"]
    },
    "sentry:sourcemaps": {
      "env": ["SENTRY_AUTH_TOKEN", "SENTRY_ORG", "SENTRY_PROJECT"]
    }
  }
}
