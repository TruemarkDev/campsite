{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ES2020",
    "moduleResolution": "Node",
    "allowJs": true,
    "skipLibCheck": true,
    // Must match packages/ui's own lib (@campsite/tsconfig/nextjs.json), since we
    // typecheck its sources directly. A narrower lib here fails on any modern
    // method it uses (e.g. Array.prototype.at). UI code runs in the plugin's
    // Chromium iframe, not the Figma sandbox, so esnext lib is safe.
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "target": "ES5",
    "typeRoots": ["node_modules/@figma", "node_modules/@types"],
    "baseUrl": "."
  },
  "include": ["global.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
