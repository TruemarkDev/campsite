#!/usr/bin/env ruby

require 'mysql2'
require 'pg'
require 'uri'

source = URI(ENV.fetch('SOURCE_MYSQL_URL'))
target = URI(ENV.fetch('TARGET_PG_URL'))
patroni_target = ARGV.delete('--patroni-target')
abort "Unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
disposable_target = target.host == '127.0.0.1' && target.port == 5436
live_target = patroni_target && target.host == '127.0.0.1' && target.port == 5438 && target.path == '/campsite_production'
abort 'Source must be disposable MySQL on 127.0.0.1:3307' unless source.host == '127.0.0.1' && source.port == 3307
abort 'Target must be disposable PostgreSQL or the explicit Patroni tunnel' unless disposable_target || live_target

mysql = Mysql2::Client.new(host: source.host, port: source.port, username: URI.decode_www_form_component(source.user), password: URI.decode_www_form_component(source.password.to_s), database: source.path.delete_prefix('/'), cast: false, symbolize_keys: false)
pg = PG.connect(ENV.fetch('TARGET_PG_URL'))
if live_target
  identity = pg.exec('SELECT current_user, host(inet_server_addr()) AS server, pg_is_in_recovery() AS replica').first
  abort 'Patroni target identity mismatch' unless identity['current_user'] == 'campsite_app' &&
    %w[192.168.10.33 192.168.10.35].include?(identity['server']) && identity['replica'] == 'f'
end
quote = ->(name) { PG::Connection.quote_ident(name) }
mysql_quote = ->(name) { "`#{name.gsub('`', '``')}`" }
tables = pg.exec("SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename").map { |r| r['tablename'] }
source_tables = mysql.query("SHOW FULL TABLES WHERE Table_type = 'BASE TABLE'").map { |r| r.values.first }
abort "TABLE_SET_MISMATCH #{(tables - source_tables).join(',')}" unless (tables - source_tables).empty?

# PostgreSQL checks ordinary foreign keys during COPY. Load each parent before
# its children instead of relying on alphabetical table names.
dependencies = tables.to_h { |table| [table, []] }
pg.exec(<<~SQL).each do |row|
  SELECT fk.conname AS name, child.relname AS child, parent.relname AS parent
  FROM pg_constraint fk
  JOIN pg_class child ON child.oid = fk.conrelid
  JOIN pg_namespace child_namespace ON child_namespace.oid = child.relnamespace
  JOIN pg_class parent ON parent.oid = fk.confrelid
  JOIN pg_namespace parent_namespace ON parent_namespace.oid = parent.relnamespace
  WHERE fk.contype = 'f'
    AND child_namespace.nspname = 'public'
    AND parent_namespace.nspname = 'public'
SQL
  # sources.current_snapshot_id is nullable and points back to snapshots.
  # Load sources with NULL there, then restore the pointer after snapshots exist.
  next if row['name'] == 'fk_beads_sources_current_snapshot' || row['child'] == row['parent']

  dependencies.fetch(row['child']) << row['parent']
end
ordered_tables = []
remaining = tables.dup
until remaining.empty?
  ready = remaining.select { |table| (dependencies.fetch(table) - ordered_tables).empty? }
  abort "FOREIGN_KEY_CYCLE #{remaining.join(',')}" if ready.empty?

  ordered_tables.concat(ready)
  remaining -= ready
end

pg.transaction do |conn|
  conn.exec("TRUNCATE #{tables.map { |t| "public.#{quote.call(t)}" }.join(', ')} RESTART IDENTITY CASCADE") unless tables.empty?
  ordered_tables.each do |table|
    columns = conn.exec_params(<<~SQL, [table]).map { |r| r['name'] }
      SELECT a.attname AS name FROM pg_attribute a
      WHERE a.attrelid = format('public.%I', $1::text)::regclass AND a.attnum > 0
        AND NOT a.attisdropped AND a.attgenerated = '' ORDER BY a.attnum
    SQL
    types = conn.exec_params(<<~SQL, [table]).to_h { |r| [r['name'], r['type']] }
      SELECT a.attname AS name, format_type(a.atttypid, NULL) AS type FROM pg_attribute a
      WHERE a.attrelid = format('public.%I', $1::text)::regclass AND a.attnum > 0 AND NOT a.attisdropped
    SQL
    mysql_info = mysql.query("SHOW COLUMNS FROM #{mysql_quote.call(table)}").to_a.to_h { |r| [r['Field'], r['Type']] }
    abort "COLUMN_SET_MISMATCH #{table}" unless (columns - mysql_info.keys).empty?
    keys = conn.exec_params(<<~SQL, [table]).map { |r| r['name'] }
      SELECT a.attname AS name FROM pg_index i JOIN pg_attribute a
        ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey)
      WHERE i.indrelid = format('public.%I', $1::text)::regclass AND i.indisprimary
      ORDER BY array_position(i.indkey, a.attnum)
    SQL
    order = (keys.empty? ? columns : keys).map { |c| mysql_quote.call(c) }.join(', ')
    names = columns.map { |c| mysql_quote.call(c) }.join(', ')
    count = 0
    offset = 0
    loop do
      rows = mysql.query("SELECT #{names} FROM #{mysql_quote.call(table)} ORDER BY #{order} LIMIT 1000 OFFSET #{offset}").to_a
      break if rows.empty?
      copy_sql = "COPY public.#{quote.call(table)} (#{columns.map { |c| quote.call(c) }.join(', ')}) FROM STDIN WITH (FORMAT csv, NULL '\\N')"
      conn.copy_data(copy_sql) do
        rows.each do |row|
          values = columns.map do |column|
            value = row[column]
            value = nil if table == 'project_beads_sources' && column == 'current_snapshot_id'
            if types[column] == 'boolean' && mysql_info[column].start_with?('tinyint(1)') && !value.nil?
              value.to_s == '1' ? 't' : 'f'
            else
              value
            end
          end
          conn.put_copy_data(values.map { |v| v.nil? ? '\\N' : "\"#{v.to_s.gsub('"', '""')}\"" }.join(',') + "\n")
        end
      end
      count += rows.length
      offset += rows.length
    end
    sequence = columns.include?('id') ? conn.exec_params('SELECT pg_get_serial_sequence($1, $2) AS sequence', ["public.#{table}", 'id']).first['sequence'] : nil
    if sequence
      max = conn.exec("SELECT MAX(id) AS maximum FROM public.#{quote.call(table)}").first['maximum']
      conn.exec_params('SELECT setval($1::regclass, $2::bigint, $3::boolean)', [sequence, max || 1, !max.nil?])
    end
    puts "COPIED #{table} count=#{count}"
  end

  mysql.query('SELECT id, current_snapshot_id FROM project_beads_sources WHERE current_snapshot_id IS NOT NULL ORDER BY id').each do |row|
    conn.exec_params('UPDATE project_beads_sources SET current_snapshot_id = $1 WHERE id = $2',
                     [row['current_snapshot_id'], row['id']])
  end
end
mysql.close
pg.close
