#!/usr/bin/env ruby

# Compare table content without ever rendering row values. MySQL and PostgreSQL
# connections are supplied through MYSQL_URL and POSTGRES_URL.
require 'digest'
require 'json'
require 'time'
require 'optparse'
require 'pg'
require 'mysql2'
require 'uri'

options = { check_sequences: false, patroni_target: false }
OptionParser.new do |parser|
  parser.on('--check-sequences', 'Verify PostgreSQL sequences are ahead of migrated ids') { options[:check_sequences] = true }
  parser.on('--patroni-target', 'Verify the explicitly selected Patroni target') { options[:patroni_target] = true }
end.parse!

mysql_url = ENV.fetch('SOURCE_MYSQL_URL')
postgres_url = ENV.fetch('TARGET_PG_URL')
mysql_uri = URI(mysql_url)
postgres_uri = URI(postgres_url)
disposable_target = postgres_uri.host == '127.0.0.1' && postgres_uri.port == 5436
live_target = options[:patroni_target] && postgres_uri.host == '127.0.0.1' && postgres_uri.port == 5438 && postgres_uri.path == '/campsite_production'
abort 'Source must be disposable MySQL on 127.0.0.1:3307' unless mysql_uri.host == '127.0.0.1' && mysql_uri.port == 3307
abort 'Target must be disposable PostgreSQL or the explicit Patroni tunnel' unless disposable_target || live_target
mysql = Mysql2::Client.new(
  host: mysql_uri.host,
  port: mysql_uri.port,
  username: URI.decode_www_form_component(mysql_uri.user.to_s),
  password: URI.decode_www_form_component(mysql_uri.password.to_s),
  database: mysql_uri.path.delete_prefix('/'),
  cast: false,
  symbolize_keys: true
)
postgres = PG.connect(postgres_url)
if live_target
  identity = postgres.exec('SELECT current_user, host(inet_server_addr()) AS server, pg_is_in_recovery() AS replica').first
  abort 'Patroni target identity mismatch' unless identity['current_user'] == 'campsite_app' &&
    %w[192.168.10.33 192.168.10.35].include?(identity['server']) && identity['replica'] == 'f'
end
failed = false

def quote_mysql(identifier)
  "`#{identifier.gsub('`', '``')}`"
end

def quote_pg(identifier)
  PG::Connection.quote_ident(identifier)
end

pg_tables = postgres.exec("SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename").map { |row| row['tablename'] }
mysql_tables = mysql.query('SHOW FULL TABLES WHERE Table_type = \'BASE TABLE\'').map { |row| row.values.first }
tables = (pg_tables & mysql_tables).sort
missing = (pg_tables - mysql_tables) | (mysql_tables - pg_tables)
unless missing.empty?
  warn "TABLE_SET_MISMATCH #{missing.join(',')}"
  failed = true
end

tables.each do |table|
  pg_columns = postgres.exec_params(<<~SQL, [table]).map { |row| row['column_name'] }
    SELECT column_name FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = $1 ORDER BY ordinal_position
  SQL
  mysql_column_info = mysql.query("SHOW COLUMNS FROM #{quote_mysql(table)}").to_a
  mysql_columns = mysql_column_info.map { |row| row[:Field] }
  generated = postgres.exec_params(<<~SQL, [table]).map { |row| row['column_name'] }
    SELECT column_name FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = $1 AND is_generated = 'ALWAYS'
  SQL
  missing_columns = pg_columns - mysql_columns - generated
  abort "COLUMN_SET_MISMATCH #{table}" unless missing_columns.empty?
  # PostgreSQL computes product_logs.device_info_* generated columns from device_info.
  columns = pg_columns & mysql_columns - generated
  column_types = postgres.exec_params(<<~SQL, [table]).to_h { |row| [row['column_name'], row['data_type']] }
    SELECT column_name, data_type FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = $1
  SQL
  mysql_types = mysql_column_info.to_h { |row| [row[:Field], row[:Type]] }
  primary_key = postgres.exec_params(<<~SQL, [table]).map { |row| row['column_name'] }
    SELECT a.attname AS column_name FROM pg_index i
    JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey)
    WHERE i.indrelid = (format('%I.%I', 'public', $1::text))::regclass AND i.indisprimary
    ORDER BY array_position(i.indkey, a.attnum)
  SQL
  keys = primary_key.empty? ? columns : primary_key
  order = keys.map { |name| quote_pg(name) }.join(', ')
  pg_rows = postgres.exec("SELECT #{columns.map { |n| quote_pg(n) }.join(', ')} FROM #{quote_pg('public')}.#{quote_pg(table)} ORDER BY #{order}")
  my_rows = mysql.query("SELECT #{columns.map { |n| quote_mysql(n) }.join(', ')} FROM #{quote_mysql(table)} ORDER BY #{keys.map { |n| quote_mysql(n) }.join(', ')}")
  pg_digest = Digest::SHA256.new
  my_digest = Digest::SHA256.new
  canonical = lambda do |row|
    columns.map do |column|
      value = row[column] || row[column.to_sym]
      if value.nil?
        nil
      elsif value.is_a?(Time)
        value.utc.iso8601(6)
      elsif column_types[column] == 'timestamp without time zone' || column_types[column] == 'timestamp with time zone'
        Time.parse(value).utc.iso8601(6) rescue value
      elsif column_types[column] == 'jsonb' || column_types[column] == 'json'
        normalize_json = ->(item) { item.is_a?(Hash) ? item.sort.to_h.transform_values { |v| normalize_json.call(v) } : item.is_a?(Array) ? item.map { |v| normalize_json.call(v) } : item }
        JSON.generate(normalize_json.call(JSON.parse(value)))
      elsif column_types[column] == 'boolean' && mysql_types[column].to_s.start_with?('tinyint(1)')
        value == '1' || value == 1 || value == true || value == 't'
      else
        value
      end
    end
  end
  pg_rows.each { |row| pg_digest << JSON.generate(canonical.call(row), sort_keys: true) << "\n" }
  my_rows.each { |row| my_digest << JSON.generate(canonical.call(row), sort_keys: true) << "\n" }
  pg_count = pg_rows.ntuples
  my_count = my_rows.count
  match = pg_count == my_count && pg_digest.hexdigest == my_digest.hexdigest
  failed ||= !match
  puts "#{match ? 'MATCH' : 'MISMATCH'} #{table} mysql_count=#{my_count} mysql_sha256=#{my_digest.hexdigest} postgres_count=#{pg_count} postgres_sha256=#{pg_digest.hexdigest}"

  next unless options[:check_sequences] && primary_key == ['id']

  sequence = postgres.exec_params('SELECT pg_get_serial_sequence($1, $2) AS sequence', ["public.#{table}", 'id']).first['sequence']
  next unless sequence

  max_id = postgres.exec("SELECT COALESCE(MAX(#{quote_pg('id')}), 0) AS maximum FROM #{quote_pg('public')}.#{quote_pg(table)}").first['maximum'].to_i
  next_value = postgres.exec("SELECT last_value, is_called FROM #{sequence}").first
  next_id = next_value['last_value'].to_i + (next_value['is_called'] == 't' ? 1 : 0)
  sequence_match = next_id > max_id
  failed ||= !sequence_match
  puts "#{sequence_match ? 'SEQUENCE_MATCH' : 'SEQUENCE_MISMATCH'} #{table} max_id=#{max_id} next_id=#{next_id}"
end

mysql.close
postgres.close
exit(failed ? 1 : 0)
