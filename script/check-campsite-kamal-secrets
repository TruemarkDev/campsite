#!/usr/bin/env ruby

require "erb"
require "pathname"
require "yaml"

ROOT = Pathname.new(__dir__).join("..").expand_path
SECRETS_PATH = ROOT.join(".kamal/secrets")

def collect_secret_names(value, names = [])
  case value
  when Hash
    value.each do |key, child|
      if %w[secret secrets].include?(key.to_s) && child.is_a?(Array)
        child.each do |entry|
          name = entry.is_a?(String) ? entry.split(":").last : nil
          names << name if name&.match?(/\A[A-Z][A-Z0-9_]*\z/)
        end
      else
        collect_secret_names(child, names)
      end
    end
  when Array
    value.each { |child| collect_secret_names(child, names) }
  end

  names
end

scope_argument = ARGV.find { |argument| argument.start_with?("--scope=") }
scope = scope_argument&.split("=", 2)&.last || "deploy"
abort "Scope must be build or deploy" unless %w[build deploy].include?(scope)

path_arguments = ARGV.reject { |argument| argument.start_with?("--scope=") }
config_paths = if path_arguments.empty?
  Dir[ROOT.join("config/deploy.campsite-*.yml")].sort
else
  path_arguments.map { |path| ROOT.join(path).expand_path.to_s }
end

abort "No Campsite Kamal configs found" if config_paths.empty?
abort "Missing ignored secret bridge: .kamal/secrets" unless SECRETS_PATH.file?

assignments = SECRETS_PATH.each_line.filter_map do |line|
  match = line.match(/\A([A-Z][A-Z0-9_]*)=\$\{?([A-Z][A-Z0-9_]*)\}?\s*\z/)
  match[1] if match && match[1] == match[2]
end.uniq

failed = false

config_paths.each do |path|
  relative_path = Pathname.new(path).relative_path_from(ROOT)
  config = YAML.safe_load(ERB.new(File.read(path)).result, aliases: true)
  secret_source = scope == "build" ? { "builder" => config.fetch("builder", {}) } : config
  required = collect_secret_names(secret_source).uniq.sort
  missing_refs = required - assignments
  missing_values = required.select { |name| ENV[name].to_s.empty? }

  if missing_refs.empty? && missing_values.empty?
    puts "#{relative_path}: #{scope} ready (#{required.length} secret names present)"
  else
    failed = true
    puts "#{relative_path}: blocked"
    puts "  missing bridge names: #{missing_refs.join(", ")}" unless missing_refs.empty?
    puts "  missing environment values: #{missing_values.join(", ")}" unless missing_values.empty?
  end
end

exit(failed ? 1 : 0)
