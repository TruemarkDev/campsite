#!/usr/bin/env ruby

# Produce the PostgreSQL test schema from Rails' MySQL schema.
# Rails' PostgreSQL schema dump canonicalizes column order and adapter metadata:
# load this output into the isolated test database, then run db:schema:dump.
# db/schema.rb remains the MySQL source schema.

require 'fileutils'

root = File.expand_path('..', __dir__)
source = ARGV[0] ? File.expand_path(ARGV[0]) : File.join(root, 'api/db/schema.rb')
destination = ARGV[1] ? File.expand_path(ARGV[1]) : File.join(root, 'api/db/schema.postgresql.rb')

schema = File.read(source)
schema.gsub!(/,?\s*unsigned: true/, '')
schema.gsub!(/,?\s*charset: "[^"]*"/, '')
schema.gsub!(/,?\s*collation: "[^"]*"/, '')
schema.gsub!(/,\s*length: (?:\{[^}]*\}|\d+)/, '')
schema.gsub!(/,\s*size: :medium/, '')
schema.gsub!(/\bt\.json\b/, 't.jsonb')
schema.gsub!(/\bmediumtext\b/, 'text')

schema.gsub!(/(  create_table "product_logs".*?^  end\n)/m) do |table|
  table.gsub(/t\.virtual "(device_info_[^"]+)", type: :string, as: "json_unquote\(json_extract\(`device_info`,_utf8mb4'\$\.([^']+)'\)\)", stored: true/) do
    column = Regexp.last_match(1)
    json_key = Regexp.last_match(2)
    "t.virtual \"#{column}\", type: :string, as: \"device_info->>'#{json_key}'\", stored: true"
  end
end

identity_columns = {
  'email_bounces' => %w[email],
  'organization_invitations' => %w[email],
  'organizations' => %w[slug],
  'users' => %w[email username]
}

table_name = nil
schema = schema.lines.map do |line|
  table_match = line.match(/^  create_table "([^"]+)"/)
  table_name = table_match[1] if table_match
  line = line.sub(/t\.(?:string|text) "(#{identity_columns.values.flatten.join('|')})"/) do |column|
    identity_columns.fetch(table_name, []).include?(Regexp.last_match(1)) ? column.sub(/t\.(?:string|text)/, 't.citext') : column
  end
  table_name = nil if line == "  end\n"
  line
end.join

schema.sub!(/(ActiveRecord::Schema\[\d+\.\d+\]\.define\(version: [^)]+\) do\n)/, "\\1  enable_extension \"citext\"\n")

FileUtils.mkdir_p(File.dirname(destination))
File.write(destination, schema)
puts "Wrote #{destination} from #{source}"
